DB_HOST=localhost
# Com o PgBouncer do docker-compose, a aplicação conecta na porta 6432.
DB_PORT=6432
DB_NAME=crm
DB_USER=crm
DB_PASSWORD=change-me
# Pool por instância da aplicação (o PgBouncer multiplexa para o PostgreSQL).
DB_POOL_MAX=10
# PostgreSQL real, sem pooler: usado pelo Prisma CLI (db:sync) e lido pelo docker-compose.
DIRECT_DB_HOST=localhost
DIRECT_DB_PORT=5432
POSTGRESQL_HOST=host.docker.internal
POSTGRESQL_PORT=5432
# Cache Redis (opcional): sem REDIS_URL a aplicação consulta o banco normalmente.
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-por-uma-chave-forte
EVOLUTION_INSTANCE=crm
EVOLUTION_DB_PASSWORD=troque-esta-senha
