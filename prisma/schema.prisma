generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id
  name              String
  email             String             @unique
  jobTitle          String?
  /// CPF (só dígitos): liga o usuário ao vendedor do VMSet (visão de vendedor no app). SQL: prisma/seller-link.sql
  cpf               String?
  teamLevel         String             @default("Operador")
  roleId            String?
  roleRef           Role?              @relation(fields: [roleId], references: [id], onDelete: SetNull)
  emailVerified     Boolean            @default(false)
  image             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  role              String             @default("user")
  banned            Boolean            @default(false)
  banReason         String?
  banExpires        DateTime?
  mustChangePassword Boolean           @default(false)
  sessions          Session[]
  accounts          Account[]
  npsResponses      NpsResponse[]
  chatQueues        ChatQueueMember[]
  chatAgent         ChatAgent?
  chatAssigned      ChatConversation[] @relation("ChatAssignee")
  npsFeedbacks      NpsFeedback[]
  followUps         FollowUp[]
  scheduledMessages ScheduledMessage[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Contact {
  id                        String                 @id @default(cuid())
  sourceKey                 String                 @unique
  name                      String
  cpf                       String?
  phone                     String?
  email                     String?
  birthDate                 String?
  gender                    String?
  occupation                String?
  city                      String?
  neighborhood              String?
  state                     String?
  store                     String?
  segment                   String?
  category                  String                 @default("cliente")
  lastPurchaseDate          String?
  prescriptionExpiry        String?
  purchases                 Int                    @default(0)
  totalSpent                Decimal                @default(0) @db.Decimal(14, 2)
  ecommerceCustomerId       String?                @unique
  ecommerceUpdatedAt        DateTime?
  ecommercePurchases        Int                    @default(0)
  ecommerceTotalSpent       Decimal                @default(0) @db.Decimal(14, 2)
  ecommerceLastPurchaseDate String?
  avatarUrl                 String?
  /// Pediu para não receber campanhas (SAIR/PARAR no WhatsApp ou marcado pela equipe).
  marketingOptOut           Boolean                @default(false)
  marketingOptOutAt         DateTime?
  marketingOptOutReason     String?
  /// Número sem WhatsApp (erro 131026 da Meta): fora dos disparos pagos até o cliente escrever de novo.
  invalidWhatsApp           Boolean                @default(false)
  invalidWhatsAppAt         DateTime?
  invalidWhatsAppReason     String?
  /// Score de engajamento no WhatsApp: +5 leu campanha, +15 respondeu, −5 por campanha não lida em 72 h.
  engagementScore           Int                    @default(0)
  engagementUpdatedAt       DateTime?
  /// Lead Score: pontos alterados pelas automações (nó Alterar pontuação) e pela equipe.
  score                     Int                    @default(0)
  /// Nível pelas faixas configuradas em /clientes-vip: BRONZE | PRATA | OURO | DIAMANTE.
  tier                      String                 @default("BRONZE")
  scoreUpdatedAt            DateTime?
  /// Matriz RFV-P (nota 1 a 5 por pilar), código "RFV-P" (ex.: 435-2), segmento e quando mudou.
  rfvpR                     Int?
  rfvpF                     Int?
  rfvpV                     Int?
  rfvpP                     Int?
  rfvpCode                  String?
  rfvpSegment               String?
  rfvpUpdatedAt             DateTime?
  /// Campos personalizados (chave da ContactFieldDef → valor em texto).
  customFields              Json                   @default("{}")
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  scoreLogs                 ContactScoreLog[]
  importedSales             ImportedSale[]
  npsResponses              NpsResponse[]
  chatConversations         ChatConversation[]
  notes                     ContactNote[]
  npsFeedbacks              NpsFeedback[]
  followUps                 FollowUp[]
  prescriptions             CustomerPrescription[]

  @@index([cpf])
  @@index([phone])
  @@index([email])
  @@index([name])
  @@index([marketingOptOut])
  @@index([score])
  @@index([tier])
  @@index([rfvpSegment])
  @@index([rfvpCode])
}

/// Movimentação de pontos do Lead Score (motivo, delta, saldo e nível depois).
model ContactScoreLog {
  id         String   @id @default(cuid())
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  delta      Int
  scoreAfter Int
  tierBefore String
  tierAfter  String
  reason     String   @default("")
  /// automacao | equipe | sistema
  source     String   @default("automacao")
  createdAt  DateTime @default(now())

  @@index([contactId, createdAt])
}

/// Definição de campo personalizado do contato (texto, número, data ou seleção).
model ContactFieldDef {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  /// text | number | date | select
  type      String   @default("text")
  options   Json     @default("[]")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

/// Link curto rastreado (/r/slug): identifica o contato que clicou e dispara o gatilho de automação.
model TrackedLink {
  id          String             @id @default(cuid())
  slug        String             @unique
  url         String
  contactId   String?
  flowId      String?
  /// automacao | campanha | manual
  source      String             @default("manual")
  label       String             @default("")
  clicks      Int                @default(0)
  lastClickAt DateTime?
  createdAt   DateTime           @default(now())
  clickLog    TrackedLinkClick[]

  @@index([contactId])
  @@index([createdAt])
}

model TrackedLinkClick {
  id        String      @id @default(cuid())
  linkId    String
  link      TrackedLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  contactId String?
  userAgent String      @default("")
  createdAt DateTime    @default(now())

  @@index([linkId, createdAt])
  @@index([contactId, createdAt])
}

/// Erros críticos recentes (webhooks, IA, campanhas, rotinas), gravados por lib/monitoring/error-reporter.ts.
model SystemErrorLog {
  id        String   @id @default(cuid())
  level     String   @default("error")
  source    String
  message   String
  stack     String?
  context   Json?    @db.JsonB
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source, createdAt])
}

model ContactNote {
  id         String   @id @default(cuid())
  contactId  String
  authorId   String?
  authorName String
  text       String
  createdAt  DateTime @default(now())
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
}

model Store {
  id            String   @id @default(cuid())
  number        Int      @unique
  name          String
  address       String?
  addressNumber String?
  complement    String?
  postalCode    String?
  city          String?
  state         String?
  neighborhoods String[]
  active        Boolean  @default(true)
  kind          String?
  startDate     String?
  unitIds       String[]
  radiusKm      Float    @default(20)
  lat           Float?
  lng           Float?
  /// Pin exato da loja (localização enviada pela IA): link do Google Maps colado ou endereço geocodificado em nível de rua.
  pinLat        Float?
  pinLng        Float?
  /// manual | google | nominatim | unresolved
  pinSource     String?
  pinUrl        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PlaceGeo {
  key       String   @id
  lat       Float?
  lng       Float?
  updatedAt DateTime @updatedAt
}

model ImportedSale {
  id         BigInt  @id @default(autoincrement())
  sourceFile String
  sourceRow  Int
  sourceKey  String
  data       Json    @db.JsonB
  contact    Contact @relation(fields: [sourceKey], references: [sourceKey], onDelete: Cascade)

  @@unique([sourceFile, sourceRow])
  @@index([sourceKey])
}

model CrmWorkspaceData {
  key       String   @id
  value     Json     @db.JsonB
  updatedAt DateTime @updatedAt
}

model IntegrationEvent {
  eventId    String   @id
  source     String
  eventType  String
  receivedAt DateTime @default(now())
}

model CommerceSyncRecord {
  id               String   @id @default(cuid())
  recordType       String
  sourceId         String
  customerSourceId String?
  payload          Json     @db.JsonB
  updatedAt        DateTime @updatedAt

  @@unique([recordType, sourceId])
  @@index([customerSourceId, updatedAt])
}

model NpsResponse {
  id        String   @id @default(cuid())
  surveyKey String
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  createdBy String?
  user      User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([surveyKey, createdAt])
  @@index([contactId])
}

enum NpsFeedbackStatus {
  PENDING
  ANSWERED
  EXPIRED
}

/// Pesquisa de 1 a 5 enviada no WhatsApp; PENDING é o estado de "aguardando nota".
model NpsFeedback {
  id             String            @id @default(cuid())
  conversationId String?
  contactId      String
  attendantId    String?
  queueId        String?
  phone          String
  score          Int?
  comment        String?
  status         NpsFeedbackStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  answeredAt     DateTime?
  conversation   ChatConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  contact        Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  attendant      User?             @relation(fields: [attendantId], references: [id], onDelete: SetNull)
  queue          ChatQueue?        @relation(fields: [queueId], references: [id], onDelete: SetNull)

  @@index([phone, status])
  @@index([status, createdAt])
  @@index([attendantId, createdAt])
  @@index([answeredAt])
}

model CampaignMessage {
  id            String                @id @default(cuid())
  campaignId    String
  contactId     String?
  phone         String
  whatsappMsgId String?               @unique
  status        CampaignMessageStatus @default(queued)
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  repliedAt     DateTime?
  failedAt      DateTime?
  failureReason String?
  /// Avaliado pela regra de engajamento (−5 se ficou 72 h sem leitura). Envios anteriores ao recurso já vêm preenchidos.
  engagementPenalizedAt DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([campaignId])
  @@index([whatsappMsgId])
  @@index([status])
  @@index([contactId])
}

model InboundMessage {
  id            String   @id @default(cuid())
  whatsappMsgId String   @unique
  contactId     String?
  phone         String
  text          String?
  mediaType     String?
  receivedAt    DateTime @default(now())

  @@index([contactId])
  @@index([phone])
}

enum CampaignMessageStatus {
  queued
  sent
  delivered
  read
  replied
  failed
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json     @default("{}") @db.JsonB
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

enum ChatStatus {
  bot
  waiting
  in_progress
  closed
}

enum ChatPriority {
  low
  normal
  high
  urgent
}

enum ChatAuthor {
  customer
  agent
  bot
  system
}

enum ChatDelivery {
  sending
  sent
  delivered
  read
  failed
}

model ChatQueue {
  id                  String             @id @default(cuid())
  name                String
  description         String             @default("")
  color               String             @default("#002187")
  hours               String             @default("")
  firstResponseSlaMin Int                @default(15)
  /// "manual" (atendentes pegam da fila) ou "round_robin" (rodízio 1 a 1 entre online com vaga).
  distribution        String             @default("manual")
  /// Rodízio prioriza atendentes da loja do cliente (Contact.store) antes do transbordo geral.
  storePriority       Boolean            @default(false)
  rrCursor            Int                @default(0)
  order               Int                @default(0)
  archivedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  members             ChatQueueMember[]
  conversations       ChatConversation[]
  npsFeedbacks        NpsFeedback[]
}

model ChatQueueMember {
  userId    String
  queueId   String
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  queue     ChatQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@id([userId, queueId])
  @@index([queueId])
}

model ChatAgent {
  userId     String    @id
  capacity   Int       @default(0)
  paused     Boolean   @default(false)
  lastSeenAt DateTime?
  /// Legado (v1.101.0): loja única; o vínculo atual é `stores`.
  store      String?
  /// Lojas do ERP VMSet do usuário ("13", "5"): o rodízio por loja prioriza estes atendentes.
  stores     String[]  @default([])
  /// Escolha do operador: ONLINE (recebe novos), AWAY (ausente/pausa) ou OFFLINE. `paused` acompanha (≠ ONLINE).
  presenceStatus String @default("ONLINE")
  /// Última interação real (clique, digitação, envio) no CRM; base da pausa automática por inatividade.
  lastActivityAt DateTime?
  /// Ausente colocado pelo sistema (inatividade): a próxima interação volta para Online sozinha.
  awayAuto   Boolean   @default(false)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatConversation {
  id                String             @id @default(cuid())
  contactId         String
  phone             String
  openKey           String?            @unique
  queueId           String?
  assigneeId        String?
  status            ChatStatus         @default(waiting)
  priority          ChatPriority       @default(normal)
  subject           String             @default("")
  unreadCount       Int                @default(0)
  waitingSince      DateTime?
  lastMessageAt     DateTime?
  lastInboundAt     DateTime?
  tags              String[]           @default([])
  menuState         Json?
  campaignId        String?
  campaignName      String?
  closedAt          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  contact           Contact            @relation(fields: [contactId], references: [id], onDelete: Restrict)
  queue             ChatQueue?         @relation(fields: [queueId], references: [id], onDelete: SetNull)
  assignee          User?              @relation("ChatAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages          ChatMessage[]
  aiPendingActions  AiPendingAction[]
  npsFeedbacks      NpsFeedback[]
  followUps         FollowUp[]
  scheduledMessages ScheduledMessage[]

  @@index([queueId, status, waitingSince])
  @@index([assigneeId, closedAt])
  @@index([contactId, createdAt])
  @@index([lastMessageAt])
  @@index([createdAt])
  @@index([closedAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  author         ChatAuthor
  authorUserId   String?
  authorName     String?
  text           String           @default("")
  delivery       ChatDelivery?
  failureReason  String?
  internal       Boolean          @default(false)
  attachment     Json?
  metaMedia      Json?
  replyTo        Json?
  externalId     String?          @unique
  /// Texto do áudio do cliente (whisper); status: pending | done | failed.
  transcription       String?
  transcriptionStatus String?
  /// Mensagem apagada no /chat; scope "me" (só no CRM) ou "everyone" (revogada no WhatsApp). O conteúdo fica para auditoria.
  deletedAt      DateTime?
  deletedScope   String?
  deletedById    String?
  deletedByName  String?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ChatQuickReply {
  id         String   @id @default(cuid())
  title      String
  text       String
  shortcut   String   @default("")
  automatic  Boolean  @default(false)
  triggers   String[] @default([])
  variations String[] @default([])
  queueId    String?
  /// Categoria livre (Geral, Vendas, Pós-venda, Financeiro...).
  category   String?
  /// Nulo = resposta de toda a equipe; preenchido = resposta pessoal deste usuário.
  ownerId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([queueId, title])
  @@index([ownerId])
}

model ChatBlockedNumber {
  phone     String   @id
  reason    String   @default("")
  createdBy String?
  createdAt DateTime @default(now())
}

model ChatNotification {
  id             String    @id @default(cuid())
  userId         String
  conversationId String?
  type           String
  title          String
  detail         String    @default("")
  href           String    @default("/chat")
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, readAt])
}

model ChatDispatch {
  key       String   @id
  createdAt DateTime @default(now())
}

model ChatAudit {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  targetId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([targetId, createdAt])
}

model ChatSettings {
  id        String   @id
  menu      Json
  updatedAt DateTime @updatedAt
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

/// Lembrete de retorno ao cliente marcado pelo atendente na conversa.
model FollowUp {
  id             String           @id @default(cuid())
  conversationId String
  contactId      String
  userId         String
  dueAt          DateTime
  note           String           @default("")
  status         FollowUpStatus   @default(PENDING)
  completedAt    DateTime?
  /// Aviso de vencimento já enviado ao atendente (o relógio avisa uma vez).
  notifiedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact        Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueAt])
  @@index([conversationId, status])
  @@index([status, dueAt])
}

enum ScheduledMessageStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

/// Mensagem de texto do atendente para sair num horário marcado (o relógio por minuto dispara).
model ScheduledMessage {
  id             String                 @id @default(cuid())
  conversationId String
  userId         String
  text           String
  scheduledFor   DateTime
  status         ScheduledMessageStatus @default(SCHEDULED)
  failureReason  String?
  messageId      String?
  sentAt         DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  conversation   ChatConversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([conversationId, status])
}

/// Horário de atendimento: `scope` é "global" ou o id de uma fila (a fila tem prioridade sobre o geral).
model OperatingHours {
  scope            String   @id
  enabled          Boolean  @default(false)
  /// [{ day: 0..6 (domingo = 0), open: "08:00", close: "18:00" }]
  schedule         Json     @default("[]")
  autoReplyMessage String   @default("")
  updatedAt        DateTime @updatedAt
}

/// Espelho das vendas do VMSet (Oracle), mantido por scripts/vmset-sync.py. Ver prisma/vmset-sale.sql.
model VmsetSale {
  key            String    @id
  sourceKey      String?
  partnerId      String?
  customerName   String?
  store          String?
  seller         String?
  orderNumber    String?
  invoiceNumber  String?
  orderDate      DateTime? @db.Date
  invoiceDate    DateTime? @db.Date
  type           String?
  category       String?
  subcategory    String?
  productCode    String?
  description    String?
  brand          String?
  quantity       Decimal?  @db.Decimal(14, 3)
  amount         Decimal?  @db.Decimal(14, 2)
  discount       Decimal?  @db.Decimal(14, 2)
  payment        String?
  paymentTerms   String?
  paymentAmount  Decimal?  @db.Decimal(14, 2)
  itemMovementId String?
  syncedAt       DateTime  @default(now()) @db.Timestamptz(6)

  @@index([orderDate])
  @@index([sourceKey])
}

/// Consumo da IA (OpenAI): uma linha por chamada, base do painel de gastos em Configurações.
model AiUsage {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  feature        String
  model          String
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  costUsd        Decimal  @default(0) @db.Decimal(12, 6)
  conversationId String?
  userId         String?
  ok             Boolean  @default(true)

  @@index([createdAt])
}

/// Foto do produto achada na web (o ERP não tem imagens), por código do produto; validade de 30 dias.
/// Ficha do produto pesquisada na web pela IA (por modelo, 30 dias; details nulo = sem resultado).
model ProductDetailCache {
  key       String   @id
  query     String
  details   String?
  updatedAt DateTime @updatedAt
}

model ProductImageCache {
  sku       String   @id
  query     String
  imageUrl  String?
  source    String   @default("web")
  updatedAt DateTime @updatedAt
}

/// Receita oftalmológica do cliente: extraída pela IA (foto/PDF no WhatsApp) ou lançada pelo atendente.
model CustomerPrescription {
  id                 String    @id @default(cuid())
  contactId          String
  contact            Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId     String?
  /// Mensagem com o arquivo original (uma receita por mensagem: reprocessar não duplica).
  messageId          String?   @unique
  attachmentUrl      String?
  odEsferico         String?
  odCilindrico       String?
  odEixo             String?
  odAdicao           String?
  odDnp              String?
  oeEsferico         String?
  oeCilindrico       String?
  oeEixo             String?
  oeAdicao           String?
  oeDnp              String?
  dpTotal            String?
  tipoLenteSugerido  String?
  observacoes        String?
  medicoNome         String?
  medicoCrm          String?
  dataReceita        DateTime?
  /// "ia_extracao" | "manual"
  origem             String    @default("manual")
  conferidoPorHumano Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([contactId, createdAt])
}

/// Ação da IA aguardando o operador (ex.: parcelas do crediário): nada vai ao cliente antes da aprovação no /chat.
model AiPendingAction {
  id                  String           @id @default(cuid())
  conversationId      String
  conversation        ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// "financial_installments"
  type                String
  /// pending | approved | rejected | superseded
  status              String           @default("pending")
  customerNameVmset   String?
  customerCpfMasked   String?
  /// CPF consultado (só dígitos), para reconsulta; nunca vai para o cliente nem para o log.
  cpf                 String?
  installmentsSummary Json?
  draftMessage        String
  transcribedText     String?
  heardName           String?
  nameMatches         Boolean          @default(true)
  decidedById         String?
  decidedByName       String?
  decidedAt           DateTime?
  sentMessageId       String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([conversationId, status])
  @@index([status, createdAt])
}

/// Estúdio de IA: regra da empresa em Markdown por assunto, injetada no prompt quando o assunto aparece.
model AiBusinessRule {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  /// Palavras-chave / gatilho do assunto (minúsculas).
  keywords      String[] @default([])
  content       String   @default("")
  order         Int      @default(0)
  active        Boolean  @default(true)
  /// Entra em toda resposta, independente do assunto.
  alwaysInclude Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, order])
}

/// Estúdio de IA: liga/desliga de cada skill nativa (sem linha = ligada) e instruções extras.
model AiSkillConfig {
  key          String   @id
  enabled      Boolean  @default(true)
  instructions String   @default("")
  updatedAt    DateTime @updatedAt
}

/// Skill da IA em Markdown (Estúdio de IA). Nativas (builtin) ligam/desligam ferramentas do motor pelo slug.
model AiSkill {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  triggerDescription String   @default("")
  instructionsMd     String   @default("")
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  builtin            Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// Base de conhecimento (RAG): documento enviado (arquivo ou texto) dividido em trechos.
model KnowledgeDocument {
  id         String           @id @default(cuid())
  title      String
  /// "texto" | "pdf" | "txt" | "md"
  source     String           @default("texto")
  fileName   String?
  content    String           @default("")
  active     Boolean          @default(true)
  /// "pendente" | "indexado" | "parcial" (sem embeddings, só busca textual) | "erro"
  status     String           @default("pendente")
  error      String?
  chunkCount Int              @default(0)
  /// Fonte automática (lojas, horarios, pedidos, precos, crediario): ligar/desligar substitui o antigo toggle; não vira trechos de RAG.
  systemKey  String?          @unique
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  chunks     KnowledgeChunk[]
}

/// Trecho indexado da base de conhecimento, com embedding OpenAI (busca híbrida textual + vetorial).
model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  index      Int
  content    String
  embedding  Float[]           @default([])
  createdAt  DateTime          @default(now())

  @@index([documentId, index])
}

/// Memória vetorial da IA (prisma/ai-knowledge-vector.sql): base de conhecimento, catálogo, atendimentos padrão ouro e
/// correções do copiloto. Com pgvector no servidor, a coluna "embeddingVec" vector(1536) + HNSW (fora do Prisma) acelera a busca.
model AiKnowledgeVector {
  id          String   @id @default(cuid())
  /// KNOWLEDGE_BASE | PRODUCT_CATALOG | CLOSED_CONVERSATION | COPILOT_CORRECTION
  sourceType  String
  sourceId    String
  title       String   @default("")
  content     String
  metadata    Json     @default("{}")
  embedding   Float[]  @default([]) @db.Real
  contentHash String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sourceType, sourceId], map: "AiKnowledgeVector_source_key")
  @@index([sourceType])
}

/// Automação visual (/automacoes): grafo do fluxo (nós e conexões em JSON) e o gatilho que o inicia.
model AutomationFlow {
  id            String                @id @default(cuid())
  name          String
  description   String                @default("")
  /// "draft" | "active" | "paused"
  status        String                @default("draft")
  /// Tipo do nó de gatilho (trigger_message, trigger_stage, trigger_tag, trigger_inactive, trigger_webhook).
  triggerType   String                @default("")
  nodes         Json                  @default("[]")
  edges         Json                  @default("[]")
  /// Segredo da URL do gatilho Webhook Externo.
  webhookToken  String                @default("")
  /// Configurações globais: { cancelOnConversion: ("purchase" | "paid" | "won")[] }.
  settings      Json                  @default("{}")
  createdById   String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  executions    AutomationExecution[]

  @@index([status, triggerType])
  @@index([webhookToken])
}

/// Um contato percorrendo um fluxo: nó atual, quando retomar (delay) e variáveis da execução.
model AutomationExecution {
  id             String              @id @default(cuid())
  flowId         String
  flow           AutomationFlow      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  contactId      String
  conversationId String?
  /// "running" | "waiting" | "completed" | "failed" | "cancelled"
  status         String              @default("running")
  currentNodeId  String?
  resumeAt       DateTime?
  /// Trava do container que está executando (outro container só retoma depois que expira).
  lockedUntil    DateTime?
  context        Json                @default("{}")
  error          String?
  startedAt      DateTime            @default(now())
  finishedAt     DateTime?
  updatedAt      DateTime            @updatedAt
  steps          AutomationStepLog[]

  @@index([status, resumeAt])
  @@index([contactId, status])
  @@index([flowId, status])
}

/// Log passo a passo de uma execução (histórico na tela).
/// Evento do ERP (venda, parcela, OS...) já entregue a um gatilho: nunca dispara duas vezes o mesmo evento no mesmo nó.
model AutomationTriggerEvent {
  id        String   @id @default(cuid())
  flowId    String
  nodeId    String
  /// Ex.: "venda:12-34567", "titulo:ABC:5days", "aniversario:<contato>:2026".
  eventKey  String
  contactId String
  createdAt DateTime @default(now())

  @@unique([flowId, nodeId, eventKey])
  @@index([createdAt])
}

/// Contadores por nó no canvas (entradas, conclusões, erros) e cursor da Roleta de Vendedores.
model AutomationNodeStat {
  flowId    String
  nodeId    String
  entered   Int      @default(0)
  completed Int      @default(0)
  errors    Int      @default(0)
  rrCursor  Int      @default(0)
  updatedAt DateTime @default(now())

  @@id([flowId, nodeId])
}

/// Mensagem enviada por um nó Enviar WhatsApp: entregue (tique da Meta) e respondida pelo cliente.
model AutomationMessageTouch {
  id             String    @id @default(cuid())
  flowId         String
  nodeId         String
  executionId    String
  contactId      String
  conversationId String?
  externalId     String?
  sentAt         DateTime  @default(now())
  deliveredAt    DateTime?
  repliedAt      DateTime?

  @@index([flowId, nodeId])
  @@index([externalId])
  @@index([contactId, sentAt])
}

/// Venda do VMSet atribuída a um nó por onde o cliente passou dentro da janela de atribuição do fluxo.
model AutomationSaleAttribution {
  id        String   @id
  flowId    String
  nodeId    String
  contactId String
  saleKey   String
  amount    Float    @default(0)
  saleDate  DateTime
  createdAt DateTime @default(now())

  @@unique([flowId, nodeId, saleKey])
  @@index([flowId])
}

model AutomationStepLog {
  id          String              @id @default(cuid())
  executionId String
  execution   AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeId      String
  nodeType    String
  /// "ok" | "error" | "waiting" | "skipped" | "cancelled"
  status      String
  message     String              @default("")
  createdAt   DateTime            @default(now())

  @@index([executionId, createdAt])
}

/// Pontualidade por CPF vinda do VMSet (parcelas de carnê/boleto/crédito interno vencidas na janela do RFV-P).
model VmsetPunctuality {
  cpf            String   @id
  due            Int      @default(0)
  onTime         Int      @default(0)
  avgDelay       Float    @default(0)
  maxOverdueDays Int      @default(0)
  syncedAt       DateTime @default(now())
}

/// Vídeos de treinamento do /manual. O arquivo fica no armazenamento de mídia (MinIO), nunca no repositório.
model ManualVideo {
  id           String   @id @default(cuid())
  title        String
  description  String?
  category     String?
  storageKey   String
  mimeType     String
  sizeBytes    BigInt
  /// Duração em segundos (lida do arquivo no navegador no envio).
  duration     Int?
  thumbnailKey String?
  order        Int      @default(0)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([order])
}

/// Lembretes de pós-venda enviados pelo job diário (revisão de grau 11 meses, reposição de lentes de contato).
/// Um por tipo e pedido do VMSet: nunca duplica. Ver prisma/commercial-suite.sql.
model CommercialReminder {
  id        String   @id @default(cuid())
  /// "rx_review" | "contact_lens"
  kind      String
  /// Loja + pedido do VMSet.
  saleKey   String
  contactId String?
  phone     String?
  dueDate   DateTime @db.Date
  /// "sent" | "failed" | "skipped"
  status    String
  detail    String?
  createdAt DateTime @default(now())

  @@unique([kind, saleKey])
  @@index([contactId, kind, createdAt])
  @@index([createdAt])
}

/// Motivo de perda de conversas encerradas sem venda (análise semanal), base do mapa de objeções.
model ConversationObjection {
  conversationId String   @id
  contactId      String
  assigneeId     String?
  closedAt       DateTime
  reason         String
  evidence       String?
  weekKey        String
  createdAt      DateTime @default(now())

  @@index([closedAt])
  @@index([weekKey])
}

/// Catálogo do VMSET persistido (página /produtos lê daqui; sincronização incremental em segundo plano).
/// Ver prisma/catalog-cache.sql e lib/catalog/catalog-store.ts.
model CatalogProduct {
  code           String   @id
  description    String
  reference      String?
  ean            String?
  brand          String?
  category       String?
  subcategory    String?
  ncm            String?
  color          String?
  material       String?
  eyeSize        String?
  bridge         String?
  warrantyMonths Int?
  price          Float?
  priceMin       Float?
  priceMax       Float?
  imageUrl       String?
  /// Produto sumiu do retrato do ERP: fica inativo (nunca apagado).
  active         Boolean  @default(true)
  /// Hash dos campos do ERP: só grava quando algo mudou.
  hash           String
  updatedAt      DateTime @default(now())
  lastSyncedAt   DateTime @default(now())

  @@index([category])
  @@index([active])
}

/// Saldo por loja do catálogo persistido (só linhas com saldo ou reserva).
model CatalogStock {
  code      String
  unit      String
  erpName   String
  available Float
  reserved  Float
  syncedAt  DateTime @default(now())

  @@id([code, unit])
}

/// Vendedor do VMSet espelhado no CRM (ativo e com venda nos últimos 60 dias), base das metas. SQL: prisma/seller-goals.sql
model Seller {
  id          String       @id @default(cuid())
  /// VENDEDOR_ID do VMSet (PARCEIRO_ID).
  vmsetId     String       @unique
  name        String
  /// CPF (só dígitos) e e-mails do cadastro do parceiro no VMSet: vínculo automático com o usuário do CRM. SQL: prisma/seller-link.sql
  cpf         String?
  emails      String[]     @default([])
  /// Loja principal (a que mais vendeu nos últimos 60 dias), código do VMSet.
  storeNumber Int?
  /// Todas as lojas onde vendeu no período.
  stores      Int[]
  active      Boolean      @default(true)
  lastSaleAt  DateTime?    @db.Date
  sales60d    Decimal?     @db.Decimal(14, 2)
  syncedAt    DateTime?    @db.Timestamptz(6)
  /// Usuário do CRM deste vendedor (recebe a comemoração das conquistas). Vinculado pelo nome ou manualmente.
  userId      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  goals       SellerGoal[]

  @@index([storeNumber])
  @@index([userId])
}

/// Meta mensal do vendedor (R$). A meta da loja é a soma das metas dos vendedores daquela loja no mês.
model SellerGoal {
  id          String   @id @default(cuid())
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  /// "2026-11"
  month       String
  /// Loja da meta (fica gravada: trocar o vendedor de loja não muda metas passadas).
  storeNumber Int?
  /// Meta em R$ (0 = sem meta em valor).
  amount      Decimal  @default(0) @db.Decimal(14, 2)
  /// Meta em quantidade de vendas (pedidos); nulo/0 = sem meta em quantidade. SQL: prisma/goal-quantity.sql
  quantity    Decimal? @db.Decimal(14, 2)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sellerId, month])
  @@index([month, storeNumber])
}

/// Meta mensal da empresa (scope "company", key "global") ou de uma marca (scope "brand", key = marca do VMSet em caixa alta).
model SalesGoal {
  id          String   @id @default(cuid())
  /// "2026-11"
  month       String
  scope       String
  key         String
  label       String
  /// Meta em R$ (0 = sem meta em valor).
  amount      Decimal  @default(0) @db.Decimal(14, 2)
  /// Meta em unidades vendidas (peças); nulo/0 = sem meta em quantidade.
  quantity    Decimal? @db.Decimal(14, 2)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([month, scope, key])
}

/// Campanha comercial com premiação (ex.: "Foco Stepper"). SQL: prisma/sales-campaigns.sql
model SalesCampaign {
  id           String            @id @default(cuid())
  name         String
  description  String?
  /// "VALOR" (R$ vendido) ou "QUANTIDADE" (unidades vendidas).
  metric       String            @default("VALOR")
  /// Marca do VMSet em caixa alta (ex.: "STEPPER"); vazio = todas.
  brand        String?
  /// Categoria do VMSet (ex.: "ARMACAO", "OCULOS SOLAR", "LENTES"); vazio = todas.
  category     String?
  /// Lojas que entram na campanha; vazio = todas.
  stores       Int[]
  startDate    DateTime          @db.Date
  endDate      DateTime          @db.Date
  /// "INDIVIDUAL" (vendedor), "LOJA" ou "GRUPO" (lojas agrupadas em `groups`).
  audience     String            @default("INDIVIDUAL")
  /// [{ "name": "Grupo 1", "stores": [1, 2, 3] }]
  groups       Json              @default("[]")
  /// Meta (R$ ou unidades). Em "RECORRENTE" é o tamanho do bloco (ex.: a cada 3 unidades).
  target       Decimal           @db.Decimal(14, 2)
  /// "UNICO" (ao bater a meta), "RECORRENTE" (a cada bloco) ou "RANKING" (1º lugar de cada grupo ao fim do período).
  rewardMode   String            @default("UNICO")
  rewardLabel  String            @default("")
  rewardAmount Decimal           @default(0) @db.Decimal(14, 2)
  active       Boolean           @default(true)
  evaluatedAt  DateTime?         @db.Timestamptz(6)
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  achievements GoalAchievement[]

  @@index([active, endDate])
}

/// Prêmio conquistado (um por bloco/tier); a chave única impede registro duplicado.
model GoalAchievement {
  id              String            @id @default(cuid())
  campaignId      String
  campaign        SalesCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// "seller" ou "store".
  participantType String
  participantKey  String
  participantName String
  tier            Int
  progress        Decimal           @db.Decimal(14, 2)
  headline        String
  rewardLabel     String
  rewardAmount    Decimal           @db.Decimal(14, 2)
  achievedAt      DateTime          @default(now()) @db.Timestamptz(6)
  celebrations    GoalCelebration[]

  @@unique([campaignId, participantKey, tier])
}

/// Comemoração (confete + parabéns) de uma conquista para um usuário; seenAt marca que já foi vista.
model GoalCelebration {
  id            String          @id @default(cuid())
  achievementId String
  achievement   GoalAchievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  userId        String
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  seenAt        DateTime?       @db.Timestamptz(6)

  @@unique([achievementId, userId])
  @@index([userId, seenAt])
}
