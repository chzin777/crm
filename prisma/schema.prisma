generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String     @id
  name             String
  email            String     @unique
  jobTitle         String?
  teamLevel        String     @default("Operador")
  roleId           String?
  roleRef          Role?      @relation(fields: [roleId], references: [id], onDelete: SetNull)
  emailVerified    Boolean    @default(false)
  image            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  role             String     @default("user")
  banned           Boolean    @default(false)
  banReason        String?
  banExpires       DateTime?
  sessions         Session[]
  accounts         Account[]
  npsResponses     NpsResponse[]
  chatQueues       ChatQueueMember[]
  chatAgent        ChatAgent?
  chatAssigned     ChatConversation[] @relation("ChatAssignee")

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])

  @@map("verification")
}

model Contact {
  id                 String         @id @default(cuid())
  sourceKey          String         @unique
  name               String
  cpf                String?
  phone              String?
  email              String?
  birthDate          String?
  gender             String?
  occupation         String?
  city               String?
  neighborhood       String?
  state              String?
  store              String?
  segment            String?
  category           String         @default("cliente")
  lastPurchaseDate   String?
  prescriptionExpiry String?
  purchases          Int            @default(0)
  totalSpent         Decimal        @default(0) @db.Decimal(14, 2)
  ecommerceCustomerId       String?   @unique
  ecommerceUpdatedAt        DateTime?
  ecommercePurchases        Int       @default(0)
  ecommerceTotalSpent       Decimal   @default(0) @db.Decimal(14, 2)
  ecommerceLastPurchaseDate String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  importedSales      ImportedSale[]
  npsResponses       NpsResponse[]
  chatConversations  ChatConversation[]

  @@index([cpf])
  @@index([phone])
  @@index([email])
  @@index([name])
}

model Store {
  id            String   @id @default(cuid())
  number        Int      @unique
  name          String
  address       String?
  addressNumber String?
  complement    String?
  postalCode    String?
  city          String?
  state         String?
  neighborhoods String[]
  active        Boolean  @default(true)
  kind          String?
  startDate     String?
  unitIds       String[]
  radiusKm      Float    @default(20)
  lat           Float?
  lng           Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PlaceGeo {
  key       String   @id
  lat       Float?
  lng       Float?
  updatedAt DateTime @updatedAt
}

model ImportedSale {
  id         BigInt   @id @default(autoincrement())
  sourceFile String
  sourceRow  Int
  sourceKey  String
  data       Json     @db.JsonB
  contact    Contact  @relation(fields: [sourceKey], references: [sourceKey], onDelete: Cascade)

  @@unique([sourceFile, sourceRow])
  @@index([sourceKey])
}

model CrmWorkspaceData {
  key       String   @id
  value     Json     @db.JsonB
  updatedAt DateTime @updatedAt
}

model IntegrationEvent {
  eventId    String   @id
  source     String
  eventType  String
  receivedAt DateTime @default(now())
}

model CommerceSyncRecord {
  id               String   @id @default(cuid())
  recordType       String
  sourceId         String
  customerSourceId String?
  payload          Json     @db.JsonB
  updatedAt        DateTime @updatedAt

  @@unique([recordType, sourceId])
  @@index([customerSourceId, updatedAt])
}

model NpsResponse {
  id        String   @id @default(cuid())
  surveyKey String
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  createdBy String?
  user      User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([surveyKey, createdAt])
  @@index([contactId])
}

model CampaignMessage {
  id              String                @id @default(cuid())
  campaignId      String
  contactId       String?
  phone           String
  whatsappMsgId   String?               @unique
  status          CampaignMessageStatus @default(queued)
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  repliedAt       DateTime?
  failedAt        DateTime?
  failureReason   String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([campaignId])
  @@index([whatsappMsgId])
  @@index([status])
  @@index([contactId])
}

model InboundMessage {
  id            String   @id @default(cuid())
  whatsappMsgId String   @unique
  contactId     String?
  phone         String
  text          String?
  mediaType     String?
  receivedAt    DateTime @default(now())

  @@index([contactId])
  @@index([phone])
}

enum CampaignMessageStatus {
  queued
  sent
  delivered
  read
  replied
  failed
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json     @default("{}") @db.JsonB
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}


enum ChatStatus {
  bot
  waiting
  in_progress
  closed
}

enum ChatPriority {
  low
  normal
  high
  urgent
}

enum ChatAuthor {
  customer
  agent
  bot
  system
}

enum ChatDelivery {
  sending
  sent
  delivered
  read
  failed
}

model ChatQueue {
  id                  String             @id @default(cuid())
  name                String
  description         String             @default("")
  color               String             @default("#002187")
  hours               String             @default("")
  firstResponseSlaMin Int                @default(15)
  order               Int                @default(0)
  archivedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  members             ChatQueueMember[]
  conversations       ChatConversation[]
}

model ChatQueueMember {
  userId    String
  queueId   String
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  queue     ChatQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@id([userId, queueId])
  @@index([queueId])
}

model ChatAgent {
  userId     String    @id
  capacity   Int       @default(0)
  paused     Boolean   @default(false)
  lastSeenAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatConversation {
  id            String        @id @default(cuid())
  contactId     String
  phone         String
  openKey       String?       @unique
  queueId       String?
  assigneeId    String?
  status        ChatStatus    @default(waiting)
  priority      ChatPriority  @default(normal)
  subject       String        @default("")
  unreadCount   Int           @default(0)
  waitingSince  DateTime?
  lastMessageAt DateTime?
  lastInboundAt DateTime?
  tags          String[]      @default([])
  menuState     Json?
  campaignId    String?
  campaignName  String?
  closedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  contact       Contact       @relation(fields: [contactId], references: [id], onDelete: Restrict)
  queue         ChatQueue?    @relation(fields: [queueId], references: [id], onDelete: SetNull)
  assignee      User?         @relation("ChatAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages      ChatMessage[]

  @@index([queueId, status, waitingSince])
  @@index([assigneeId, closedAt])
  @@index([contactId, createdAt])
  @@index([lastMessageAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  author         ChatAuthor
  authorUserId   String?
  authorName     String?
  text           String           @default("")
  delivery       ChatDelivery?
  failureReason  String?
  internal       Boolean          @default(false)
  attachment     Json?
  metaMedia      Json?
  replyTo        Json?
  externalId     String?          @unique
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ChatQuickReply {
  id         String   @id @default(cuid())
  title      String
  text       String
  shortcut   String   @default("")
  automatic  Boolean  @default(false)
  triggers   String[] @default([])
  variations String[] @default([])
  queueId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([queueId, title])
}

model ChatBlockedNumber {
  phone     String   @id
  reason    String   @default("")
  createdBy String?
  createdAt DateTime @default(now())
}

model ChatNotification {
  id             String    @id @default(cuid())
  userId         String
  conversationId String?
  type           String
  title          String
  detail         String    @default("")
  href           String    @default("/chat")
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, readAt])
}

model ChatDispatch {
  key       String   @id
  createdAt DateTime @default(now())
}

model ChatAudit {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  targetId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([targetId, createdAt])
}

model ChatSettings {
  id        String   @id
  menu      Json
  updatedAt DateTime @updatedAt
}
