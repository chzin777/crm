generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id
  name              String
  email             String             @unique
  jobTitle          String?
  teamLevel         String             @default("Operador")
  roleId            String?
  roleRef           Role?              @relation(fields: [roleId], references: [id], onDelete: SetNull)
  emailVerified     Boolean            @default(false)
  image             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  role              String             @default("user")
  banned            Boolean            @default(false)
  banReason         String?
  banExpires        DateTime?
  sessions          Session[]
  accounts          Account[]
  npsResponses      NpsResponse[]
  chatQueues        ChatQueueMember[]
  chatAgent         ChatAgent?
  chatAssigned      ChatConversation[] @relation("ChatAssignee")
  npsFeedbacks      NpsFeedback[]
  followUps         FollowUp[]
  scheduledMessages ScheduledMessage[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Contact {
  id                        String                 @id @default(cuid())
  sourceKey                 String                 @unique
  name                      String
  cpf                       String?
  phone                     String?
  email                     String?
  birthDate                 String?
  gender                    String?
  occupation                String?
  city                      String?
  neighborhood              String?
  state                     String?
  store                     String?
  segment                   String?
  category                  String                 @default("cliente")
  lastPurchaseDate          String?
  prescriptionExpiry        String?
  purchases                 Int                    @default(0)
  totalSpent                Decimal                @default(0) @db.Decimal(14, 2)
  ecommerceCustomerId       String?                @unique
  ecommerceUpdatedAt        DateTime?
  ecommercePurchases        Int                    @default(0)
  ecommerceTotalSpent       Decimal                @default(0) @db.Decimal(14, 2)
  ecommerceLastPurchaseDate String?
  avatarUrl                 String?
  /// Pediu para não receber campanhas (SAIR/PARAR no WhatsApp ou marcado pela equipe).
  marketingOptOut           Boolean                @default(false)
  marketingOptOutAt         DateTime?
  marketingOptOutReason     String?
  /// Lead Score: pontos alterados pelas automações (nó Alterar pontuação) e pela equipe.
  score                     Int                    @default(0)
  /// Nível pelas faixas configuradas em /clientes-vip: BRONZE | PRATA | OURO | DIAMANTE.
  tier                      String                 @default("BRONZE")
  scoreUpdatedAt            DateTime?
  /// Campos personalizados (chave da ContactFieldDef → valor em texto).
  customFields              Json                   @default("{}")
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  scoreLogs                 ContactScoreLog[]
  importedSales             ImportedSale[]
  npsResponses              NpsResponse[]
  chatConversations         ChatConversation[]
  notes                     ContactNote[]
  npsFeedbacks              NpsFeedback[]
  followUps                 FollowUp[]
  prescriptions             CustomerPrescription[]

  @@index([cpf])
  @@index([phone])
  @@index([email])
  @@index([name])
  @@index([marketingOptOut])
  @@index([score])
  @@index([tier])
}

/// Movimentação de pontos do Lead Score (motivo, delta, saldo e nível depois).
model ContactScoreLog {
  id         String   @id @default(cuid())
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  delta      Int
  scoreAfter Int
  tierBefore String
  tierAfter  String
  reason     String   @default("")
  /// automacao | equipe | sistema
  source     String   @default("automacao")
  createdAt  DateTime @default(now())

  @@index([contactId, createdAt])
}

/// Definição de campo personalizado do contato (texto, número, data ou seleção).
model ContactFieldDef {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  /// text | number | date | select
  type      String   @default("text")
  options   Json     @default("[]")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

/// Link curto rastreado (/r/slug): identifica o contato que clicou e dispara o gatilho de automação.
model TrackedLink {
  id          String             @id @default(cuid())
  slug        String             @unique
  url         String
  contactId   String?
  flowId      String?
  /// automacao | campanha | manual
  source      String             @default("manual")
  label       String             @default("")
  clicks      Int                @default(0)
  lastClickAt DateTime?
  createdAt   DateTime           @default(now())
  clickLog    TrackedLinkClick[]

  @@index([contactId])
  @@index([createdAt])
}

model TrackedLinkClick {
  id        String      @id @default(cuid())
  linkId    String
  link      TrackedLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  contactId String?
  userAgent String      @default("")
  createdAt DateTime    @default(now())

  @@index([linkId, createdAt])
  @@index([contactId, createdAt])
}

/// Erros críticos recentes (webhooks, IA, campanhas, rotinas), gravados por lib/monitoring/error-reporter.ts.
model SystemErrorLog {
  id        String   @id @default(cuid())
  level     String   @default("error")
  source    String
  message   String
  stack     String?
  context   Json?    @db.JsonB
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source, createdAt])
}

model ContactNote {
  id         String   @id @default(cuid())
  contactId  String
  authorId   String?
  authorName String
  text       String
  createdAt  DateTime @default(now())
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
}

model Store {
  id            String   @id @default(cuid())
  number        Int      @unique
  name          String
  address       String?
  addressNumber String?
  complement    String?
  postalCode    String?
  city          String?
  state         String?
  neighborhoods String[]
  active        Boolean  @default(true)
  kind          String?
  startDate     String?
  unitIds       String[]
  radiusKm      Float    @default(20)
  lat           Float?
  lng           Float?
  /// Pin exato da loja (localização enviada pela IA): link do Google Maps colado ou endereço geocodificado em nível de rua.
  pinLat        Float?
  pinLng        Float?
  /// manual | google | nominatim | unresolved
  pinSource     String?
  pinUrl        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PlaceGeo {
  key       String   @id
  lat       Float?
  lng       Float?
  updatedAt DateTime @updatedAt
}

model ImportedSale {
  id         BigInt  @id @default(autoincrement())
  sourceFile String
  sourceRow  Int
  sourceKey  String
  data       Json    @db.JsonB
  contact    Contact @relation(fields: [sourceKey], references: [sourceKey], onDelete: Cascade)

  @@unique([sourceFile, sourceRow])
  @@index([sourceKey])
}

model CrmWorkspaceData {
  key       String   @id
  value     Json     @db.JsonB
  updatedAt DateTime @updatedAt
}

model IntegrationEvent {
  eventId    String   @id
  source     String
  eventType  String
  receivedAt DateTime @default(now())
}

model CommerceSyncRecord {
  id               String   @id @default(cuid())
  recordType       String
  sourceId         String
  customerSourceId String?
  payload          Json     @db.JsonB
  updatedAt        DateTime @updatedAt

  @@unique([recordType, sourceId])
  @@index([customerSourceId, updatedAt])
}

model NpsResponse {
  id        String   @id @default(cuid())
  surveyKey String
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  createdBy String?
  user      User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([surveyKey, createdAt])
  @@index([contactId])
}

enum NpsFeedbackStatus {
  PENDING
  ANSWERED
  EXPIRED
}

/// Pesquisa de 1 a 5 enviada no WhatsApp; PENDING é o estado de "aguardando nota".
model NpsFeedback {
  id             String            @id @default(cuid())
  conversationId String?
  contactId      String
  attendantId    String?
  queueId        String?
  phone          String
  score          Int?
  comment        String?
  status         NpsFeedbackStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  answeredAt     DateTime?
  conversation   ChatConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  contact        Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  attendant      User?             @relation(fields: [attendantId], references: [id], onDelete: SetNull)
  queue          ChatQueue?        @relation(fields: [queueId], references: [id], onDelete: SetNull)

  @@index([phone, status])
  @@index([status, createdAt])
  @@index([attendantId, createdAt])
  @@index([answeredAt])
}

model CampaignMessage {
  id            String                @id @default(cuid())
  campaignId    String
  contactId     String?
  phone         String
  whatsappMsgId String?               @unique
  status        CampaignMessageStatus @default(queued)
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  repliedAt     DateTime?
  failedAt      DateTime?
  failureReason String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([campaignId])
  @@index([whatsappMsgId])
  @@index([status])
  @@index([contactId])
}

model InboundMessage {
  id            String   @id @default(cuid())
  whatsappMsgId String   @unique
  contactId     String?
  phone         String
  text          String?
  mediaType     String?
  receivedAt    DateTime @default(now())

  @@index([contactId])
  @@index([phone])
}

enum CampaignMessageStatus {
  queued
  sent
  delivered
  read
  replied
  failed
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json     @default("{}") @db.JsonB
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

enum ChatStatus {
  bot
  waiting
  in_progress
  closed
}

enum ChatPriority {
  low
  normal
  high
  urgent
}

enum ChatAuthor {
  customer
  agent
  bot
  system
}

enum ChatDelivery {
  sending
  sent
  delivered
  read
  failed
}

model ChatQueue {
  id                  String             @id @default(cuid())
  name                String
  description         String             @default("")
  color               String             @default("#002187")
  hours               String             @default("")
  firstResponseSlaMin Int                @default(15)
  order               Int                @default(0)
  archivedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  members             ChatQueueMember[]
  conversations       ChatConversation[]
  npsFeedbacks        NpsFeedback[]
}

model ChatQueueMember {
  userId    String
  queueId   String
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  queue     ChatQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@id([userId, queueId])
  @@index([queueId])
}

model ChatAgent {
  userId     String    @id
  capacity   Int       @default(0)
  paused     Boolean   @default(false)
  lastSeenAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatConversation {
  id                String             @id @default(cuid())
  contactId         String
  phone             String
  openKey           String?            @unique
  queueId           String?
  assigneeId        String?
  status            ChatStatus         @default(waiting)
  priority          ChatPriority       @default(normal)
  subject           String             @default("")
  unreadCount       Int                @default(0)
  waitingSince      DateTime?
  lastMessageAt     DateTime?
  lastInboundAt     DateTime?
  tags              String[]           @default([])
  menuState         Json?
  campaignId        String?
  campaignName      String?
  closedAt          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  contact           Contact            @relation(fields: [contactId], references: [id], onDelete: Restrict)
  queue             ChatQueue?         @relation(fields: [queueId], references: [id], onDelete: SetNull)
  assignee          User?              @relation("ChatAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages          ChatMessage[]
  aiPendingActions  AiPendingAction[]
  npsFeedbacks      NpsFeedback[]
  followUps         FollowUp[]
  scheduledMessages ScheduledMessage[]

  @@index([queueId, status, waitingSince])
  @@index([assigneeId, closedAt])
  @@index([contactId, createdAt])
  @@index([lastMessageAt])
  @@index([createdAt])
  @@index([closedAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  author         ChatAuthor
  authorUserId   String?
  authorName     String?
  text           String           @default("")
  delivery       ChatDelivery?
  failureReason  String?
  internal       Boolean          @default(false)
  attachment     Json?
  metaMedia      Json?
  replyTo        Json?
  externalId     String?          @unique
  /// Texto do áudio do cliente (whisper); status: pending | done | failed.
  transcription       String?
  transcriptionStatus String?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ChatQuickReply {
  id         String   @id @default(cuid())
  title      String
  text       String
  shortcut   String   @default("")
  automatic  Boolean  @default(false)
  triggers   String[] @default([])
  variations String[] @default([])
  queueId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([queueId, title])
}

model ChatBlockedNumber {
  phone     String   @id
  reason    String   @default("")
  createdBy String?
  createdAt DateTime @default(now())
}

model ChatNotification {
  id             String    @id @default(cuid())
  userId         String
  conversationId String?
  type           String
  title          String
  detail         String    @default("")
  href           String    @default("/chat")
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, readAt])
}

model ChatDispatch {
  key       String   @id
  createdAt DateTime @default(now())
}

model ChatAudit {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  targetId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([targetId, createdAt])
}

model ChatSettings {
  id        String   @id
  menu      Json
  updatedAt DateTime @updatedAt
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

/// Lembrete de retorno ao cliente marcado pelo atendente na conversa.
model FollowUp {
  id             String           @id @default(cuid())
  conversationId String
  contactId      String
  userId         String
  dueAt          DateTime
  note           String           @default("")
  status         FollowUpStatus   @default(PENDING)
  completedAt    DateTime?
  /// Aviso de vencimento já enviado ao atendente (o relógio avisa uma vez).
  notifiedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact        Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueAt])
  @@index([conversationId, status])
  @@index([status, dueAt])
}

enum ScheduledMessageStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

/// Mensagem de texto do atendente para sair num horário marcado (o relógio por minuto dispara).
model ScheduledMessage {
  id             String                 @id @default(cuid())
  conversationId String
  userId         String
  text           String
  scheduledFor   DateTime
  status         ScheduledMessageStatus @default(SCHEDULED)
  failureReason  String?
  messageId      String?
  sentAt         DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  conversation   ChatConversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([conversationId, status])
}

/// Horário de atendimento: `scope` é "global" ou o id de uma fila (a fila tem prioridade sobre o geral).
model OperatingHours {
  scope            String   @id
  enabled          Boolean  @default(false)
  /// [{ day: 0..6 (domingo = 0), open: "08:00", close: "18:00" }]
  schedule         Json     @default("[]")
  autoReplyMessage String   @default("")
  updatedAt        DateTime @updatedAt
}

/// Espelho das vendas do VMSet (Oracle), mantido por scripts/vmset-sync.py. Ver prisma/vmset-sale.sql.
model VmsetSale {
  key            String    @id
  sourceKey      String?
  partnerId      String?
  customerName   String?
  store          String?
  seller         String?
  orderNumber    String?
  invoiceNumber  String?
  orderDate      DateTime? @db.Date
  invoiceDate    DateTime? @db.Date
  type           String?
  category       String?
  subcategory    String?
  productCode    String?
  description    String?
  brand          String?
  quantity       Decimal?  @db.Decimal(14, 3)
  amount         Decimal?  @db.Decimal(14, 2)
  discount       Decimal?  @db.Decimal(14, 2)
  payment        String?
  paymentTerms   String?
  paymentAmount  Decimal?  @db.Decimal(14, 2)
  itemMovementId String?
  syncedAt       DateTime  @default(now()) @db.Timestamptz(6)

  @@index([orderDate])
  @@index([sourceKey])
}

/// Consumo da IA (OpenAI): uma linha por chamada, base do painel de gastos em Configurações.
model AiUsage {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  feature        String
  model          String
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  costUsd        Decimal  @default(0) @db.Decimal(12, 6)
  conversationId String?
  userId         String?
  ok             Boolean  @default(true)

  @@index([createdAt])
}

/// Foto do produto achada na web (o ERP não tem imagens), por código do produto; validade de 30 dias.
/// Ficha do produto pesquisada na web pela IA (por modelo, 30 dias; details nulo = sem resultado).
model ProductDetailCache {
  key       String   @id
  query     String
  details   String?
  updatedAt DateTime @updatedAt
}

model ProductImageCache {
  sku       String   @id
  query     String
  imageUrl  String?
  source    String   @default("web")
  updatedAt DateTime @updatedAt
}

/// Receita oftalmológica do cliente: extraída pela IA (foto/PDF no WhatsApp) ou lançada pelo atendente.
model CustomerPrescription {
  id                 String    @id @default(cuid())
  contactId          String
  contact            Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId     String?
  /// Mensagem com o arquivo original (uma receita por mensagem: reprocessar não duplica).
  messageId          String?   @unique
  attachmentUrl      String?
  odEsferico         String?
  odCilindrico       String?
  odEixo             String?
  odAdicao           String?
  odDnp              String?
  oeEsferico         String?
  oeCilindrico       String?
  oeEixo             String?
  oeAdicao           String?
  oeDnp              String?
  dpTotal            String?
  tipoLenteSugerido  String?
  observacoes        String?
  medicoNome         String?
  medicoCrm          String?
  dataReceita        DateTime?
  /// "ia_extracao" | "manual"
  origem             String    @default("manual")
  conferidoPorHumano Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([contactId, createdAt])
}

/// Ação da IA aguardando o operador (ex.: parcelas do crediário): nada vai ao cliente antes da aprovação no /chat.
model AiPendingAction {
  id                  String           @id @default(cuid())
  conversationId      String
  conversation        ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// "financial_installments"
  type                String
  /// pending | approved | rejected | superseded
  status              String           @default("pending")
  customerNameVmset   String?
  customerCpfMasked   String?
  /// CPF consultado (só dígitos), para reconsulta; nunca vai para o cliente nem para o log.
  cpf                 String?
  installmentsSummary Json?
  draftMessage        String
  transcribedText     String?
  heardName           String?
  nameMatches         Boolean          @default(true)
  decidedById         String?
  decidedByName       String?
  decidedAt           DateTime?
  sentMessageId       String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([conversationId, status])
  @@index([status, createdAt])
}

/// Estúdio de IA: regra da empresa em Markdown por assunto, injetada no prompt quando o assunto aparece.
model AiBusinessRule {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  /// Palavras-chave / gatilho do assunto (minúsculas).
  keywords      String[] @default([])
  content       String   @default("")
  order         Int      @default(0)
  active        Boolean  @default(true)
  /// Entra em toda resposta, independente do assunto.
  alwaysInclude Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, order])
}

/// Estúdio de IA: liga/desliga de cada skill nativa (sem linha = ligada) e instruções extras.
model AiSkillConfig {
  key          String   @id
  enabled      Boolean  @default(true)
  instructions String   @default("")
  updatedAt    DateTime @updatedAt
}

/// Skill da IA em Markdown (Estúdio de IA). Nativas (builtin) ligam/desligam ferramentas do motor pelo slug.
model AiSkill {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  triggerDescription String   @default("")
  instructionsMd     String   @default("")
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  builtin            Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// Base de conhecimento (RAG): documento enviado (arquivo ou texto) dividido em trechos.
model KnowledgeDocument {
  id         String           @id @default(cuid())
  title      String
  /// "texto" | "pdf" | "txt" | "md"
  source     String           @default("texto")
  fileName   String?
  content    String           @default("")
  active     Boolean          @default(true)
  /// "pendente" | "indexado" | "parcial" (sem embeddings, só busca textual) | "erro"
  status     String           @default("pendente")
  error      String?
  chunkCount Int              @default(0)
  /// Fonte automática (lojas, horarios, pedidos, precos, crediario): ligar/desligar substitui o antigo toggle; não vira trechos de RAG.
  systemKey  String?          @unique
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  chunks     KnowledgeChunk[]
}

/// Trecho indexado da base de conhecimento, com embedding OpenAI (busca híbrida textual + vetorial).
model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  index      Int
  content    String
  embedding  Float[]           @default([])
  createdAt  DateTime          @default(now())

  @@index([documentId, index])
}

/// Automação visual (/automacoes): grafo do fluxo (nós e conexões em JSON) e o gatilho que o inicia.
model AutomationFlow {
  id            String                @id @default(cuid())
  name          String
  description   String                @default("")
  /// "draft" | "active" | "paused"
  status        String                @default("draft")
  /// Tipo do nó de gatilho (trigger_message, trigger_stage, trigger_tag, trigger_inactive, trigger_webhook).
  triggerType   String                @default("")
  nodes         Json                  @default("[]")
  edges         Json                  @default("[]")
  /// Segredo da URL do gatilho Webhook Externo.
  webhookToken  String                @default("")
  /// Configurações globais: { cancelOnConversion: ("purchase" | "paid" | "won")[] }.
  settings      Json                  @default("{}")
  createdById   String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  executions    AutomationExecution[]

  @@index([status, triggerType])
  @@index([webhookToken])
}

/// Um contato percorrendo um fluxo: nó atual, quando retomar (delay) e variáveis da execução.
model AutomationExecution {
  id             String              @id @default(cuid())
  flowId         String
  flow           AutomationFlow      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  contactId      String
  conversationId String?
  /// "running" | "waiting" | "completed" | "failed" | "cancelled"
  status         String              @default("running")
  currentNodeId  String?
  resumeAt       DateTime?
  /// Trava do container que está executando (outro container só retoma depois que expira).
  lockedUntil    DateTime?
  context        Json                @default("{}")
  error          String?
  startedAt      DateTime            @default(now())
  finishedAt     DateTime?
  updatedAt      DateTime            @updatedAt
  steps          AutomationStepLog[]

  @@index([status, resumeAt])
  @@index([contactId, status])
  @@index([flowId, status])
}

/// Log passo a passo de uma execução (histórico na tela).
/// Evento do ERP (venda, parcela, OS...) já entregue a um gatilho: nunca dispara duas vezes o mesmo evento no mesmo nó.
model AutomationTriggerEvent {
  id        String   @id @default(cuid())
  flowId    String
  nodeId    String
  /// Ex.: "venda:12-34567", "titulo:ABC:5days", "aniversario:<contato>:2026".
  eventKey  String
  contactId String
  createdAt DateTime @default(now())

  @@unique([flowId, nodeId, eventKey])
  @@index([createdAt])
}

/// Contadores por nó no canvas (entradas, conclusões, erros) e cursor da Roleta de Vendedores.
model AutomationNodeStat {
  flowId    String
  nodeId    String
  entered   Int      @default(0)
  completed Int      @default(0)
  errors    Int      @default(0)
  rrCursor  Int      @default(0)
  updatedAt DateTime @default(now())

  @@id([flowId, nodeId])
}

/// Mensagem enviada por um nó Enviar WhatsApp: entregue (tique da Meta) e respondida pelo cliente.
model AutomationMessageTouch {
  id             String    @id @default(cuid())
  flowId         String
  nodeId         String
  executionId    String
  contactId      String
  conversationId String?
  externalId     String?
  sentAt         DateTime  @default(now())
  deliveredAt    DateTime?
  repliedAt      DateTime?

  @@index([flowId, nodeId])
  @@index([externalId])
  @@index([contactId, sentAt])
}

/// Venda do VMSet atribuída a um nó por onde o cliente passou dentro da janela de atribuição do fluxo.
model AutomationSaleAttribution {
  id        String   @id
  flowId    String
  nodeId    String
  contactId String
  saleKey   String
  amount    Float    @default(0)
  saleDate  DateTime
  createdAt DateTime @default(now())

  @@unique([flowId, nodeId, saleKey])
  @@index([flowId])
}

model AutomationStepLog {
  id          String              @id @default(cuid())
  executionId String
  execution   AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeId      String
  nodeType    String
  /// "ok" | "error" | "waiting" | "skipped" | "cancelled"
  status      String
  message     String              @default("")
  createdAt   DateTime            @default(now())

  @@index([executionId, createdAt])
}
