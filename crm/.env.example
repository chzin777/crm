DB_HOST=localhost
# Com o PgBouncer do docker-compose, a aplicação conecta na porta 6432.
DB_PORT=6432
DB_NAME=crm
DB_USER=crm
DB_PASSWORD=change-me
# Pool por instância da aplicação (o PgBouncer multiplexa para o PostgreSQL).
DB_POOL_MAX=10
# PostgreSQL real, sem pooler: usado pelo Prisma CLI (db:sync) e lido pelo docker-compose.
DIRECT_DB_HOST=localhost
DIRECT_DB_PORT=5432
POSTGRESQL_HOST=host.docker.internal
POSTGRESQL_PORT=5432
# Cache Redis (opcional): sem REDIS_URL a aplicação consulta o banco normalmente.
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Meta WhatsApp Cloud API (oficial)
META_WHATSAPP_PHONE_NUMBER_ID=seu-phone-number-id
META_WHATSAPP_ACCESS_TOKEN=seu-access-token
META_WHATSAPP_ACCOUNT_ID=seu-account-id
# Obrigatório para o webhook da Meta: token de verificação e App Secret (assinatura das notificações).
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=defina-um-token-aleatorio
META_APP_SECRET=seu-app-secret

# E-mail transacional (redefinição de senha) via Resend.
RESEND_API_KEY=sua-chave-resend
RESEND_FROM=CRM Óticas Brasil <no-reply@seu-dominio.com.br>

# Token de serviço (Authorization: Bearer) para a API do VMSet enviar contatos e lojas ao CRM.
SYNC_API_TOKEN=gere-um-token-aleatorio-longo

# Armazenamento de anexos (MinIO)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=seu-access-key
MINIO_SECRET_KEY=seu-secret-key
MINIO_BUCKET=crm-campaigns
MINIO_PUBLIC_URL=
