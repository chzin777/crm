# Porta da API
PORT=4000

# Banco do e-commerce (VMSet / oticas-site-postgres)
VMSET_DB_HOST=oticas-site-postgres
VMSET_DB_PORT=5432
VMSET_DB_NAME=oticas_site
VMSET_DB_USER=oticas_site
VMSET_DB_PASSWORD=

# Redis para cache
REDIS_URL=redis://redis:6379/1

# Cache TTL em segundos (padrão 60s)
CACHE_TTL_SECONDS=60

# API Key para autenticação dos consumidores (CRM, E-commerce)
API_KEY=change-me-to-a-strong-random-key

# Pool de conexões
DB_POOL_MAX=10